  "hosts": [
   "storm-charles.promptugal.news"
  ],
  "ports": [
   443
  ],
  "caveat": "applied by a process to its own child: a boundary for the child, a setting for the parent. The proxy does not terminate TLS: it holds hosts and ports, not paths."
 },
